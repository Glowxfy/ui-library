    return nil
end

local B64_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local B64_LOOKUP = {}
for i = 1, #B64_CHARS do
    B64_LOOKUP[string.byte(B64_CHARS, i)] = i - 1
end

local function decodeBiomeBase64(source)
    if type(source) ~= 'string' or #source % 4 ~= 0 then return nil end
    local decoder
    if type(crypt) == 'table' and type(crypt.base64) == 'table' then
        decoder = crypt.base64.decode
    elseif type(syn) == 'table' and type(syn.crypt) == 'table' and type(syn.crypt.base64) == 'table' then
        decoder = syn.crypt.base64.decode
    end
    if type(decoder) == 'function' then
        local ok, result = pcall(decoder, source)
        if ok and type(result) == 'string' and #result > 0 then return result end
    end
    local chunks = {}
    for i = 1, #source, 4 do
        local a = B64_LOOKUP[string.byte(source, i)]
        local b = B64_LOOKUP[string.byte(source, i + 1)]
        local c = B64_LOOKUP[string.byte(source, i + 2)]
        local d = B64_LOOKUP[string.byte(source, i + 3)]
        if a == nil or b == nil then return nil end
        local number = a * 262144 + b * 4096 + (c or 0) * 64 + (d or 0)
        local x = math.floor(number / 65536) % 256
        local y = math.floor(number / 256) % 256
        local z = number % 256
        chunks[#chunks + 1] = (d ~= nil and string.char(x, y, z)) or (c ~= nil and string.char(x, y)) or string.char(x)
    end
    return table.concat(chunks)
end

local BIOME_IMAGE_ASSETS = {}
local function resolveBiomeImage(routeId)
    if BIOME_IMAGE_ASSETS[routeId] then return BIOME_IMAGE_ASSETS[routeId] end

    local imageId = IMAGE_ASSET_OVERRIDES[routeId]
    if type(imageId) == 'string' and imageId ~= '' then
        local uri = imageId:match('^%d+$') and ('rbxassetid://' .. imageId) or imageId
        BIOME_IMAGE_ASSETS[routeId] = uri
        return uri
    end

    local image = EMBEDDED_BIOME_IMAGES[routeId]
    if not image then return nil end

    local assetLoader = getExecutorAPI('getcustomasset') or getExecutorAPI('getsynasset')
    local writeImage = getExecutorAPI('writefile')
    local fileExists = getExecutorAPI('isfile')
    if not assetLoader or not writeImage then return nil end

    local path = image.file or (cleanName(routeId) .. '.png')
    local canUse = true
    if type(fileExists) == 'function' then
        local ok, exists = pcall(fileExists, path)
        if ok and exists then canUse = false end
    end
    if canUse then
        local data = image.data and decodeBiomeBase64(image.data)
        if not data then return nil end
        pcall(writeImage, path, data)
    end
    local ok, uri = pcall(assetLoader, path)
    if ok and type(uri) == 'string' then
        BIOME_IMAGE_ASSETS[routeId] = uri
        return uri
    end
    return nil
end

