function PALETTES.registerBackdrop(frame)
    PALETTES.backgroundLayers[#PALETTES.backgroundLayers + 1] = { frame = frame, original = frame.BackgroundTransparency }
end

function PALETTES.setBackgroundOpacity(percent)
    local opacity = math.clamp(tonumber(percent) or 100, 0, 100) / 100
    for _, entry in ipairs(PALETTES.backgroundLayers) do
        if entry.frame and entry.frame.Parent then
            entry.frame.BackgroundTransparency = 1 - (1 - entry.original) * opacity
        end
    end
end

