                math.clamp(math.floor(palette[2].G * 255 * 0.70), 0, 255),
                math.clamp(math.floor(palette[2].B * 255 * 0.70), 0, 255)
            )
        end
    end
end

local function beveled(parent, name, x, y, w, h, theme, opts)
    opts = opts or {}
    local pal = PALETTES[theme] or PALETTES.gray
    local z = opts.z or 15

    local holder = new('Frame', parent, {
        Name = 'Button_' .. name,
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(w, h),
        BackgroundTransparency = 1,
        ZIndex = z,
    })
    local sizeScale = new('UIScale', holder, { Scale = 1 })

    local shadow = new('Frame', holder, {
        Position = UDim2.fromOffset(0, 5),
        Size = UDim2.new(1, 0, 1, -3),
        BackgroundColor3 = pal[3],
        BackgroundTransparency = 0.22,
        BorderSizePixel = 0,
        ZIndex = z,
    })
    corner(shadow, opts.nav and 10 or 8)

    local face = new('TextButton', holder, {
        Size = UDim2.new(1, 0, 1, -5),
        BackgroundColor3 = C.white,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = '',
        ClipsDescendants = true,
        ZIndex = z + 1,
    })
    corner(face, opts.nav and 10 or 8)
    local grad = gradient(face, { pal[1], pal[2], pal[2] })
    if opts.checkers ~= false then checkers(face, w, h, 14, 0.965, z + 2) end

    local faceBorder = stroke(face, 1.45)
    faceBorder.Name = 'PaletteStroke'
    faceBorder.Color = Color3.fromRGB(57, 77, 109)

    local gloss = new('Frame', face, {
        Position = UDim2.fromOffset(1, 1),
        Size = UDim2.new(1, -2, 0.42, 0),
        BackgroundColor3 = C.white,
        BackgroundTransparency = 0.90,
        BorderSizePixel = 0,
        ZIndex = z + 3,
    })
    corner(gloss, opts.nav and 10 or 8)
    new('UIGradient', gloss, {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.1),
            NumberSequenceKeypoint.new(1, 1),
        })
    })

    local activeRail
    if opts.nav then
        activeRail = new('Frame', face, {
            Name = 'SelectedRail',
            Position = UDim2.fromOffset(7, 10),
            Size = UDim2.fromOffset(5, h - 24),
            BackgroundColor3 = Color3.fromRGB(173, 244, 255),
            BorderSizePixel = 0,
            ZIndex = z + 5,
            Visible = false,
        })
        corner(activeRail, 3)
    end

    local iconAccent = new('Frame', face, {
        Position = UDim2.fromOffset(opts.nav and 18 or 10, 11),
        Size = UDim2.fromOffset(opts.nav and 8 or 0, h - 27),
        BackgroundColor3 = Color3.fromRGB(203, 244, 255),
        BackgroundTransparency = opts.nav and 0.52 or 1,
        BorderSizePixel = 0,
        ZIndex = z + 4,
    })
    if opts.nav then corner(iconAccent, 4) end

    local shine
    if opts.shimmer then
        shine = new('Frame', face, {
            Name = 'Shimmer',
            Position = UDim2.fromOffset(-40, -34),
            Size = UDim2.fromOffset(30, h + 72),
            BackgroundColor3 = C.white,
            BackgroundTransparency = 0.82,
            BorderSizePixel = 0,
            Rotation = 17,
            ZIndex = z + 4,
            Visible = false,
        })
        table.insert(buttonsWithShine, { item = shine, width = w, offset = #buttonsWithShine / 2.7 })
    end

    local caption = label(face, name, opts.nav and 28 or 0, 0, opts.nav and (w - 38) or w, h - 5, opts.fontSize or 16, {
        align = opts.nav and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
        z = z + 5,
        font = opts.font or Enum.Font.GothamBold,
    })

    local activeTween
    local function animate(value, duration)
        if activeTween then activeTween:Cancel() end
        if not settings.ButtonAnimations then sizeScale.Scale = 1 return end
        activeTween = TS:Create(sizeScale, TweenInfo.new(duration or 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = value })
        activeTween:Play()
    end

    face.MouseEnter:Connect(function()
        animate(1.03)
        if settings.ButtonAnimations then TS:Create(faceBorder, TweenInfo.new(0.16, Enum.EasingStyle.Quad), { Transparency = 0 }):Play() end
    end)
    face.MouseLeave:Connect(function()
        animate(1)
        if settings.ButtonAnimations then TS:Create(faceBorder, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Transparency = 0.08 }):Play() end
    end)
    face.MouseButton1Down:Connect(function() animate(0.96, 0.08) end)
    face.MouseButton1Up:Connect(function() animate(1.018) end)

    local function palette(value)
        if opts.nav and value ~= 'cyan' then
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, PALETTES.navIdleColors[1]),
                ColorSequenceKeypoint.new(0.54, PALETTES.navIdleColors[2]),
                ColorSequenceKeypoint.new(1, PALETTES.navIdleColors[3]),
            })
            shadow.BackgroundColor3 = PALETTES.navIdleColors[4]
            faceBorder.Color = Color3.fromRGB(54, 67, 92)
        else
            setPalette({ gradient = grad, bottom = shadow, face = face }, value)
        end
        if activeRail then activeRail.Visible = value == 'cyan' end
        if iconAccent then iconAccent.BackgroundTransparency = value == 'cyan' and 0.12 or (opts.nav and 0.52 or 1) end
        caption.TextColor3 = value == 'cyan' and C.white or (opts.nav and Color3.fromRGB(205, 217, 235) or C.white)
    end

    palette(theme)

    return {
        face = face,
        holder = holder,
        caption = caption,
        gradient = grad,
        bottom = shadow,
        palette = palette,
    }
end

